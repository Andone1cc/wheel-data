{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["hkg1"],
  "crons": [
    {
      "path": "/api/cron/cn-options-preclose-510500",
      "schedule": "50 5 * * 1-5"
    },
    {
      "path": "/api/cron/cn-options-preclose-159922",
      "schedule": "50 5 * * 1-5"
    },
    {
      "path": "/api/cron/cn-options-510500",
      "schedule": "10 8 * * 1-5"
    },
    {
      "path": "/api/cron/cn-options-159922",
      "schedule": "20 8 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/api/cn-options",     "destination": "/api/data" },
    { "source": "/api/cron/cn-options-preclose-510500", "destination": "/api/data?cronSymbol=510500&cronMode=preclose" },
    { "source": "/api/cron/cn-options-preclose-159922", "destination": "/api/data?cronSymbol=159922&cronMode=preclose" },
    { "source": "/api/cron/cn-options-510500", "destination": "/api/data?cronSymbol=510500" },
    { "source": "/api/cron/cn-options-159922", "destination": "/api/data?cronSymbol=159922" },
    { "source": "/api/health",          "destination": "/api/data" },
    { "source": "/api/cboe/:ticker",    "destination": "/api/data" },
    { "source": "/api/quote/:ticker",   "destination": "/api/data" },
    { "source": "/api/history/:ticker", "destination": "/api/data" },
    { "source": "/api/anchor-metrics",  "destination": "/api/data" },
    { "source": "/api/anchor-dividends", "destination": "/api/data" },
    { "source": "/api/futu/:path*",     "destination": "/api/data" },
    { "source": "/(.*)",                "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https: http:; img-src 'self' data: https:;"
        }
      ]
    }
  ]
}
